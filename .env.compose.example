# Copy to .env.compose. Use alphanumeric passwords so DATABASE_URL needs no URL encoding.
MYSQL_ROOT_PASSWORD=replace_with_random_root_password
MYSQL_PASSWORD=replace_with_random_app_password
OPENAI_API_KEY=replace_with_real_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
WEB_SEARCH_MODEL=gpt-6-luna
WEB_HOST_PORT=8090
# Redis in this Compose stack also stores the shared hourly request limit counters.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qa-system
