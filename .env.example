# Copy to .env and fill in your own credentials. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
WEB_SEARCH_MODEL=gpt-6-luna

# MySQL connection for accounts, knowledge bases, uploaded documents and chat history.
# Format: mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?charset=utf8mb4
# In the example below:
#   qa_app        = MySQL username (create this account first)
#   YOUR_PASSWORD = password for qa_app (replace locally; never commit it)
#   127.0.0.1     = MySQL server address; 3306 = port
#   qa_system     = database name (create this database first)
# URL-encode special characters in the password, such as @, :, / and #.
DATABASE_URL=mysql+pymysql://qa_app:YOUR_PASSWORD@127.0.0.1:3306/qa_system?charset=utf8mb4

# Stage 13: set both to enable queued indexing. Web and worker must use the same Qdrant server.
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333

# Stage 16: when REDIS_URL is set, Web enables shared hourly limits for paid requests,
# uploads and login/register attempts. Without Redis, rate limiting is disabled.

# Optional LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
# For agent-based workspaces, use the selected environment’s tracer_session_name.
# Names are case-sensitive (for example, LLM and llm are different agents).
LANGSMITH_PROJECT=qa-system
