# Copy to .env and fill in your own credentials. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Stage 10 MySQL connection (not used by the current in-memory Web app yet).
# Format: mysql+pymysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?charset=utf8mb4
# In the example below:
#   qa_app        = MySQL username (create this account first)
#   YOUR_PASSWORD = password for qa_app (replace locally; never commit it)
#   127.0.0.1     = MySQL server address; 3306 = port
#   qa_system     = database name (create this database first)
# URL-encode special characters in the password, such as @, :, / and #.
DATABASE_URL=mysql+pymysql://qa_app:YOUR_PASSWORD@127.0.0.1:3306/qa_system?charset=utf8mb4

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qa-system
